// ==========================================
// LULC Classification - Gilgit 2025
// Step 1: Sentinel-2 Composite
// ==========================================

// 1. Load Gilgit AOI
var aoi = ee.FeatureCollection(
  'projects/ee-gudia112211/assets/gilgit'
);

// 2. Load Sentinel-2
var s2 = ee.ImageCollection(
  'COPERNICUS/S2_SR_HARMONIZED'
)
.filterBounds(aoi)
.filterDate('2025-05-01', '2025-07-31')
.filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 20));

// 3. Create median composite
var composite = s2
  .median()
  .clip(aoi);

// 4. Display RGB image
var rgbVis = {
  bands: ['B4', 'B3', 'B2'],
  min: 0,
  max: 3000
};

Map.centerObject(aoi, 10);

Map.addLayer(
  composite,
  rgbVis,
  'Sentinel-2 RGB'
);

Map.addLayer(
  aoi,
  {},
  'Gilgit AOI'
);

// 5. Print number of images
print('Number of Sentinel-2 images:', s2.size());


// ==========================================
// LULC Step 2: Training Samples
// ==========================================

// Assign class values to your drawn polygons

var waterSamples = water.map(function(feature) {
  return feature.set('class', 0);
});

var vegetationSamples = vegetation.map(function(feature) {
  return feature.set('class', 1);
});

var agricultureSamples = agriculture.map(function(feature) {
  return feature.set('class', 2);
});

var barelandSamples = bareland.map(function(feature) {
  return feature.set('class', 3);
});

var builtupSamples = builtup.map(function(feature) {
  return feature.set('class', 4);
});

var snowiceSamples = snowice.map(function(feature) {
  return feature.set('class', 5);
});


// Merge all training samples

var trainingPolygons = waterSamples
  .merge(vegetationSamples)
  .merge(agricultureSamples)
  .merge(barelandSamples)
  .merge(builtupSamples)
  .merge(snowiceSamples);


// Display training polygons

Map.addLayer(
  trainingPolygons,
  {},
  'Training Samples'
);


// Print training samples

print('Training polygons:');
print('Number of training polygons:', trainingPolygons.size());


// ==========================================
// LULC Step 3: Sampling + Random Forest
// ==========================================

// Sentinel-2 bands for classification
var bands = [
  'B2', 'B3', 'B4', 'B8',
  'B11', 'B12'
];

// Sample pixels from training polygons
var training = composite.select(bands).sampleRegions({
  collection: trainingPolygons,
  properties: ['class'],
  scale: 10,
  geometries: true
});

// Check training samples
print('Training samples:', training);
print('Number of training samples:', training.size());


// ==========================================
// Random Forest Classifier
// ==========================================

var classifier = ee.Classifier.smileRandomForest({
  numberOfTrees: 100,
  seed: 42
}).train({
  features: training,
  classProperty: 'class',
  inputProperties: bands
});


// ==========================================
// Apply classifier
// ==========================================

var lulc = composite
  .select(bands)
  .classify(classifier)
  .clip(aoi);


// ==========================================
// LULC Visualization
// ==========================================

var lulcVis = {
  min: 0,
  max: 5,
  palette: [
    '0000FF', // Water
    '00FF00', // Vegetation
    'FFFF00', // Agriculture
    'C2B280', // Bare Land
    'FF0000', // Built-up
    'FFFFFF'  // Snow/Ice
  ]
};

Map.addLayer(
  lulc,
  lulcVis,
  'LULC Classification'
);


// Print classifier
print('Random Forest Classifier:', classifier);


// ==========================================
// LULC Step 4: Accuracy Assessment
// ==========================================

// Add a random number to every sample
var trainingWithRandom = training.randomColumn(
  'random',
  42
);

// 70% training data
var trainData = trainingWithRandom.filter(
  ee.Filter.lt('random', 0.7)
);

// 30% testing data
var testData = trainingWithRandom.filter(
  ee.Filter.gte('random', 0.7)
);

print('Training data:', trainData);
print('Testing data:', testData);


// ==========================================
// Train Random Forest with 70% data
// ==========================================

var rfClassifier = ee.Classifier.smileRandomForest({
  numberOfTrees: 100,
  seed: 42
}).train({
  features: trainData,
  classProperty: 'class',
  inputProperties: bands
});


// ==========================================
// Test Classification
// ==========================================

var testClassification = testData.classify(
  rfClassifier
);


// ==========================================
// Confusion Matrix
// ==========================================

var confusionMatrix = testClassification.errorMatrix(
  'class',
  'classification'
);

print(
  'Confusion Matrix:',
  confusionMatrix
);


// ==========================================
// Overall Accuracy
// ==========================================

var overallAccuracy = confusionMatrix.accuracy();

print(
  'Overall Accuracy:',
  overallAccuracy
);


// ==========================================
// Kappa
// ==========================================

var kappa = confusionMatrix.kappa();

print(
  'Kappa:',
  kappa
);


// ==========================================
// Producer Accuracy
// ==========================================

print(
  'Producer Accuracy:',
  confusionMatrix.producersAccuracy()
);


// ==========================================
// Consumer Accuracy
// ==========================================

print(
  'Consumer Accuracy:',
  confusionMatrix.consumersAccuracy()
);
